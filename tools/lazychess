# ─── install / uninstall (acceso global) ────────────────────────────────────
cmd_install(){
  step "Instalar acceso global ('lazychess' desde cualquier carpeta)"
  local dir="$HOME/.local/bin" target
  target="$dir/lazychess"
  mkdir -p "$dir"
  ln -sf "$SELF_PATH" "$target"
  ok "Symlink creado: $target → $SELF_PATH"
  case ":$PATH:" in
    *":$dir:"*) info "Listo: ya puedes escribir ${B}lazychess${N} desde cualquier carpeta.";;
    *) warn "$dir no está en tu PATH. Agrégalo a ~/.bashrc y reabre la terminal:"
       info 'export PATH="$HOME/.local/bin:$PATH"';;
  esac
}
cmd_uninstall(){
  step "Quitar acceso global"
  if [ -L "$HOME/.local/bin/lazychess" ]; then
    rm -f "$HOME/.local/bin/lazychess"; ok "Symlink eliminado."
  else
    warn "No había symlink en ~/.local/bin (nada que quitar)."
  fi
}

